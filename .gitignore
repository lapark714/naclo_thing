# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# misc
.DS_Store

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-cli scratch output (snapshots, screenshots, console logs)
.playwright-cli/

# naclo source pdfs
/pdfs
.env*
!.env.example

# generated from content/assets by npm run sync-assets
/public/content-assets

# unreviewed AI output from npm run draft; promotion into content/problems is
# the human step, and nothing in here should ever be committed as if it were
/content/drafts

# NOTE: content/parked is deliberately NOT ignored. It is the review queue for
# problems the pipeline could not vouch for, and it is meant to be read in a
# diff. lib/content.ts never loads it, so nothing in it can reach a student.

# Agent and design-tooling scratch. Untracked rather than deleted: these keep
# working locally, they just are not part of the published repository.
#
# AGENTS.md is generated and re-added by `next dev`
# (node_modules/next/dist/server/lib/generate-agent-files.js), so it has to be
# ignored rather than removed — deleting it only brings it back untracked.
/CLAUDE.md
/AGENTS.md
/.claude/
/.impeccable/
/.superpowers/
/.codex/
