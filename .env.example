# Copy to .env and fill in. Never commit the filled-in file.

# Claude API — server-side only, never exposed to the client
ANTHROPIC_API_KEY=

# Models
INGEST_MODEL=
GRADING_MODEL=
GRADING_EFFORT=

# Paths
NACLO_PDF_DIR=pdfs
CONTENT_DIR=content/problems

# Public — these DO reach the browser
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ENABLE_AI_GRADING=

# /api/grade abuse limit
GRADE_RATE_LIMIT_PER_MINUTE=
